# Build output
bin/
dist/
*.exe
/ash
/ashd
/ashmcp
/harnessbench
/mcpbench

# Per-project ash daemon state (ledger, logs, sockets if they ever land here)
.ash/

# Local env files — never check in (ANTHROPIC_API_KEY etc.).
# .env.example IS tracked as the template for contributors.
.env
.env.*
!.env.example

# Test artifacts
*.test
coverage.out
coverage.html

# Bench transient output. baseline.json / baseline.md / latency-snapshot.json
# under bench/ ARE checked in (the regression contract); latest.json is the
# transient artifact from `make bench`.
/bench/latest.json

# Vendored deps
vendor/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.idea/
.vscode/
*.swp
*~

# Per-developer Claude Code overrides (the shared project hook config is
# .claude/settings.json, which IS tracked).
.claude/settings.local.json

# Project-scope MCP server config — `command` must be an absolute path
# (Claude Code does not expand env vars in `.mcp.json`), so the file is
# inherently per-checkout-machine. See docs/adoption/claude-code.md.
.mcp.json

# ash project config — may contain absolute paths (jail allow_paths/deny_paths,
# gopls_path) that are per-checkout-machine. Developer-global settings belong
# in $XDG_CONFIG_HOME/ash/config.toml instead. Teams that use only ${root}-
# relative jail paths (ASH-229) and the default gopls_path can safely
# un-ignore this file to share project-level policy as code.
ash.toml
