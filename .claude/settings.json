{
  "permissions": {
    "allow": [
      "Bash(bin/ash *)",
      "Bash(go build *)",
      "Bash(make all)",
      "Bash(make vocab)",
      "Bash(bin/encexplore probe *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/ash\" hook"
          }
        ]
      }
    ]
  }
}
